# Copy to .env for Docker Compose. Never commit .env – it contains credentials.

SKODA_API_KEY=
SKODA_VIN=
# 4-digit S-PIN for the auxiliary heating (optional, otherwise asked for in the browser)
SKODA_SPIN=
SKODA_COMMANDS_ENABLED=false
SKODA_TIMEZONE=Europe/Berlin
# Seconds between two stored snapshots (600 = 10 minutes)
SKODA_FETCH_INTERVAL=600
# Delete snapshots older than this many days (0 = keep forever)
SKODA_HISTORY_RETENTION_DAYS=0

# sqlite (default), mysql or none
DB_DRIVER=sqlite
# Only for DB_DRIVER=mysql – "mysql" is the container from the mysql profile
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=skoda
DB_USERNAME=skoda
DB_PASSWORD=change-me

# Port of the web interface on the host
WEB_PORT=8080
